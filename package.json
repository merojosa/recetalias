{
	"name": "recetalias",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"decap:local": "pnpx decap-server",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && prettier --check . && eslint .",
		"sso": "dotenv -e .env -- aws sso login --profile=$AWS_PROFILE",
		"pulumi:login": "dotenv -e .env -- pulumi login 's3://recetalias-pulumi-state?region=us-east-1'",
		"deploy": "dotenv -e .env -- pulumi up --cwd infra --stack prod --yes --non-interactive",
		"deploy:local": "pnpm pulumi:login && dotenv -e .env -- pulumi up --cwd infra --stack prod --yes --non-interactive",
		"test:e2e": "playwright test",
		"test": "pnpm run test:e2e"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.4",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.58.2",
		"@pulumi/aws": "^7.21.0",
		"@pulumi/command": "^1.2.1",
		"@pulumi/pulumi": "^3.225.1",
		"@pulumi/synced-folder": "^0.12.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.54.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^22.19.15",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^16.5.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.10",
		"svelte-check": "^4.4.5",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.1",
		"ts-node": "^10.9.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"decap-cms-app": "^3.10.1",
		"snarkdown": "^2.0.0",
		"valibot": "^1.2.0"
	}
}
