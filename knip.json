{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	},
	"tags": ["-lintignore"],
	"ignoreFiles": ["infra/**"],
	"ignoreBinaries": ["pulumi"],
	"ignoreDependencies": [
		"@pulumi/aws",
		"@pulumi/command",
		"@pulumi/synced-folder",
		"@pulumi/pulumi"
	]
}
